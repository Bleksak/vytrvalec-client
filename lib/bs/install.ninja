rescript = 1
rule cp
  command = cp $i $out
rule touch
 command = touch $out
o API.cmi : cp ../bs/src/lib/API.cmi
o API.cmj : cp ../bs/src/lib/API.cmj
o API.cmt : cp ../bs/src/lib/API.cmt
o API.res : cp ../../src/lib/API.res
o auth.cmi : cp ../bs/src/lib/actions/auth.cmi
o auth.cmj : cp ../bs/src/lib/actions/auth.cmj
o auth.cmt : cp ../bs/src/lib/actions/auth.cmt
o auth.res : cp ../../src/lib/actions/auth.res
build install.stamp : touch API.cmi API.cmj auth.cmi auth.cmj 
